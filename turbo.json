{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "APP_ENV",
    "APP_URL",
    "DATABASE_URL",
    "REDIS_URL",
    "SESSION_SECRET",
    "MOCK_PAYMENTS",
    "FIELD_ENCRYPTION_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"]
    }
  }
}
